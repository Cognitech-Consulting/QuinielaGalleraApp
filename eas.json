{
  "cli": {
    "version": ">= 3.12.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "1"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    }
  }
}
